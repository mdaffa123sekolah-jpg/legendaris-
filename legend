  v:2,
  profile:{level:1,exp:0,sp:0,kills:0,bosses:0,runs:0,crits:0,maxCombo:0,skillUses:0,totalDmg:0},
  wallet:{gold:0,gems:0,soul:0},          // dicadangkan untuk fase berikutnya
  settings:{shake:1,particles:1,dmgNum:1},
  high:{score:0},
