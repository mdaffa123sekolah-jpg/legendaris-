  RT.sta-=COST_DODGE;RT.staCd=45;RT.dodgeCd=22;RT.dodgeT=16;RT.perf=0;
  const l=(K.ArrowLeft||K.KeyA)?-1:0,r=(K.ArrowRight||K.KeyD)?1:0,dir=(l+r)||P.face;
  P.face=dir;P.vx=dir*(P.w===0?17:26);
