<script>
/* =====================================================================
   MYTHICAL GLORY ARENA — PHASE 1 : Core combat + Character stats
   ---------------------------------------------------------------------
   Modul ini DITUMPANGKAN di atas game lama (tidak mengganti apa pun):
   - Membungkus fungsi lama: hurt(), phit(), cast(), upd(), start(), spawn(), save()
   - Menambah kait kecil di draw(): RPG.world(), RPG.hud(), RPG.menuOverlay(), RPG.stats()
   - Semua state RPG ada di objek `S` (disimpan) dan `RT` (runtime, tidak disimpan)
   - Save baru: localStorage 'mga_save_v2' (save lama 'mga5' tetap ditulis & dimigrasi)
   ===================================================================== */
(function(){
'use strict';

/* ---------- Konstanta & util ---------- */
const SAVE_KEY='mga_save_v2', MAXLV=50;
const COST_DODGE=28;                       // stamina per dodge
const ECOST={skill1:12,skill2:22,ult:45};  // energi per skill
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const rnd=R;                               // Math.random milik game lama
const need=L=>Math.round(30*Math.pow(L,1.25));   // EXP untuk naik dari level L → L+1

/* Fitur yang terbuka per level (semuanya benar-benar berfungsi di bawah) */
const UNL=[
  [1 ,'Dodge Roll'   ,'Shift/C/DASH: i-frame, memakai stamina'],
  [5 ,'Energy Surge' ,'Regenerasi energi +50%'],
  [10,'Second Wind'  ,'1x per run: bangkit dengan 30% HP'],
  [15,'Combo Mastery','Jendela combo +1 detik'],
  [20,'Arcane Ward'  ,'Ultimate memberi perisai 4 detik'],
  [30,'Berserker'    ,'+20% damage saat HP di bawah 35%'],
  [40,'Vampirism'    ,'Curi 2% damage sebagai HP'],
  [50,'Mythical Glory','+15% semua damage']
];

/* Status khas tiap senjata: [utama, sekunder] — urutan sama dengan CH[] */
const SIG=[['freeze','slow'],['stun','shock'],['burn','slow'],['slow','stun'],['poison','shock']];
const ST_DUR={freeze:70,stun:40,slow:150,burn:200,poison:260,shock:200};
const ST_CHIP={burn:['BRN','#ff8a2b'],poison:['PSN','#7be04a'],shock:['SHK','#ffe14a'],slow:['SLW','#8fb4ff'],freeze:['FRZ','#bff3ff'],stun:['STN','#ffd84a']};

