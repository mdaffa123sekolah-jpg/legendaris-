/* ---------- Efek status pada musuh ---------- */
function applyStatus(e,type,mult){
  if(!e||e.hp<=0)return;
  let d=ST_DUR[type]*(mult||1);
  if(e.boss&&(type==='freeze'||type==='stun'||type==='slow'))d*=.4;   // boss tahan CC
