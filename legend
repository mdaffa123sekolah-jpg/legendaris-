function gainExp(x){
  const p=S.profile;
  if(p.level>=MAXLV){p.exp=0;return}
  p.exp+=x;
  while(p.level<MAXLV&&p.exp>=need(p.level)){p.exp-=need(p.level);p.level++;p.sp+=1+(p.level%10===0?2:0);onLevelUp()}
  if(p.level>=MAXLV)p.exp=0;
}
function onLevelUp(){
