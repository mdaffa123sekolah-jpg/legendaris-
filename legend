    if(e.psn>0){e.psn--;if(e.psn%30===0)dot(e,base*.6*(e.psnS||1),'#7be04a');if(e.psn<=0)e.psnS=0;if(T%9===0)FX.push({k:'p',x:e.x+(rnd()-.5)*e.r,y:e.y,vx:0,vy:-.6,l:26,m:26,c:'#7be04a',z:3,g:0})}
