function load(){
  let raw=null,had5=false;
  try{raw=JSON.parse(localStorage.getItem(SAVE_KEY)||'null')}catch(e){raw=null}
  try{had5=!!localStorage.getItem('mga5')}catch(e){}
  S=merge(DEF(),raw&&typeof raw==='object'?raw:{});
  const p=S.profile;
  p.level=clamp(Math.floor(+p.level)||1,1,MAXLV);
  p.exp=Math.max(0,+p.exp||0);p.sp=Math.max(0,Math.floor(+p.sp)||0);
  if(p.level>=MAXLV)p.exp=0;
  if(!raw){                                // PERTAMA KALI: migrasi dari save lama (sudah dimuat game lama)
    S.legacy={mat:mat|0,own:own.slice(),wlevel:wlevel|0};
  }else if(!had5&&S.legacy&&Array.isArray(S.legacy.own)){   // save lama hilang → pulihkan dari v2
    mat=S.legacy.mat|0;own=newOwn().map((v,i)=>S.legacy.own[i]?1:v);wlevel=clamp(S.legacy.wlevel|0,0,5);
  }
