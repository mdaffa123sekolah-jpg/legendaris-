function pre(){
  tickEnemies();
  // stamina & energi
  if(RT.staCd>0)RT.staCd--;else RT.sta=Math.min(RT.staMax,RT.sta+.45);
  RT.en=Math.min(RT.enMax,RT.en+.12*(has(5)?1.5:1));
  if(RT.dodgeCd>0)RT.dodgeCd--;
  if(RT.staFlash>0)RT.staFlash--;
  // dodge: jejak bayangan + perfect dodge
  if(RT.dodgeT>0){
    RT.dodgeT--;
    if(RT.dodgeT%2===0){const t=RT.trail[RT.ti];RT.ti=(RT.ti+1)%RT.trail.length;t.x=P.x;t.y=P.y;t.l=t.m=14}
    if(!RT.perf){
      let near=E.some(e=>e.hp>0&&Math.hypot(e.x-P.x,e.y-P.y)<e.r+P.r+14);
      if(!near)for(const q of PR)if(q.k==='e_orb'&&Math.hypot(q.x-P.x,q.y-P.y)<46){near=true;break}
      if(near){RT.perf=1;RT.en=Math.min(RT.enMax,RT.en+18);RT.sta=Math.min(RT.staMax,RT.sta+14);RT.slow=Math.max(RT.slow,24);
        addNum(P.x,P.y-P.r-48,'PERFECT DODGE!','#9ff0ff',6,1);ring(P.x,P.y,70,'#9ff0ff');sfx('perfect')}
    }
  }
  // combo
  if(RT.comboT>0){if(--RT.comboT===0)RT.combo=0}
  if(RT.comboPop>0)RT.comboPop--;
  // perisai & regenerasi
  if(RT.shieldT>0){if(--RT.shieldT===0)RT.shield=0}
  if(RT.regen>0){RT.regen--;P.hp=Math.min(P.max,P.hp+P.max*.0004)}
  if(RT.hurtFx>0)RT.hurtFx--;
}
function post(before,was){
  // deteksi kill (hp<=0 pada daftar musuh sebelum filter lama)
  for(const e of before)if(e.hp<=0&&!e._k){e._k=1;onKill(e)}
  // bonus EXP clear stage
  if(was==='play'&&st==='clear'){const n=(season-1)*9+lvl-1;gainExp(Math.round((30+lvl*10)*(1+Math.max(0,n)*.12)*(lvl===9?2:1)));persist()}
  // Second Wind: bangkit sekali per run
  if(was==='play'&&st==='over'&&has(10)&&!RT.swUsed){
    RT.swUsed=1;st='play';P.hp=P.max*.3;P._hp=P.hp;P.inv=150;RT.regen=240;
    ring(P.x,P.y,140,'#9fffa0');burst(P.x,P.y,'#9fffa0',26,7,3.5,30);flash=.6;sfx('levelup');
    RT.lvText='SECOND WIND!';RT.lvBanner=110;RT.unlockText='Bangkit dengan 30% HP';
  }
  // speed bonus dari level
  if(st==='play'&&DD&&DD.spd>0){P.x=clamp(P.x+P.vx*DD.spd,30,WW-30)}
  // update pool angka & jejak
  for(const n of DN)if(n.l>0){n.l--;n.y+=n.vy;n.vy*=.95}
  for(const t of RT.trail)if(t.l>0)t.l--;
  if(RT.lvBanner>0)RT.lvBanner--;
  if(RT.ultFx>0)RT.ultFx--;
}
