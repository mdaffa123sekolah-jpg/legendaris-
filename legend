function merge(d,s){                       // gabung aman (tanpa prototype pollution, tipe dijaga)
  for(const k in s){
    if(BAD(k))continue;
    if(!(k in d)){d[k]=s[k];continue}
    const a=d[k],b=s[k];
    if(a&&typeof a==='object'&&!Array.isArray(a)){if(b&&typeof b==='object')merge(a,b)}
    else if(a==null||typeof a===typeof b)d[k]=b;
  }
