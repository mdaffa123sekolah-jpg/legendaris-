addEventListener('keydown',e=>{
  if(['Space','ArrowUp','ArrowDown','ArrowLeft','ArrowRight','KeyU'].includes(e.code))e.preventDefault();
  K[e.code]=1;if(e.repeat)return;
  auInit();if(e.code==='KeyO'){auToggle();return}
  if(st!=='play'){const nav=['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','KeyA','KeyD','KeyW','KeyS'].includes(e.code);sfx(nav?'tick':(e.code==='Escape'?'back':'ok'))}

  if(st==='title'){
    if(e.code==='Enter'||e.code==='Space'){st='mode0';msel=0}
  }
  else if(st==='menu'){
    if(e.code==='Escape')goHome();
    if(e.code==='ArrowLeft'||e.code==='KeyA')sel=(sel+4)%5;
    if(e.code==='ArrowRight'||e.code==='KeyD')sel=(sel+1)%5;
    if(e.code==='ArrowUp'||e.code==='KeyW'){
      if(wlevel<5){
        const nextCost=UPGRADES[wlevel+1].cost;
        if(mat>=nextCost){mat-=nextCost;wlevel++;save();sfx('upg');}
      }
    }
    if(e.code==='KeyU'){
      if(wlevel<5){const nextCost=UPGRADES[wlevel+1].cost;if(mat>=nextCost){mat-=nextCost;wlevel++;save();sfx('upg');}}
    }
    if(e.code==='Digit1'){sel=0;st='armor'}if(e.code==='Digit2'){sel=1;st='armor'}if(e.code==='Digit3'){sel=2;st='armor'}if(e.code==='Digit4'){sel=3;st='armor'}if(e.code==='Digit5'){sel=4;st='armor'}
    if(e.code==='Enter'||e.code==='Space')st='armor';
  }
  else if(st==='armor'){
    const m={ArrowLeft:-1,ArrowRight:1,ArrowUp:-5,ArrowDown:5}[e.code];if(m)asel=Math.max(0,Math.min(NA-1,asel+m));
    if(e.code==='Enter'||e.code==='Space')armorGo();
    if(e.code==='Escape')armorBack();
  }
  else if(st==='clear'){
    if(e.code==='ArrowUp')csel=(csel+2)%3;
    if(e.code==='ArrowDown')csel=(csel+1)%3;
    if(e.code==='Digit1')clearGo(0);if(e.code==='Digit2')clearGo(1);if(e.code==='Digit3')clearGo(2);
    if(e.code==='Enter')clearGo(csel);
  }
