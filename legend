<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
  import { getFirestore, collection, query, where, getDocs, doc, setDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

  // Konfigurasi otomatis terhubung ke proyek Mythical Glory Arena Anda
  const firebaseConfig = {
    apiKey: "MASUKKAN_API_KEY_ANDA", // Dapatkan dari setelan Firebase Console Anda
    authDomain: "mythical-glory-arena.firebaseapp.com",
    projectId: "mythical-glory-arena",
    storageBucket: "mythical-glory-arena.appspot.com",
    messagingSenderId: "764361804292",
    appId: "MASUKKAN_APP_ID_ANDA"
  };

  const app = initializeApp(firebaseConfig);
  const db = getFirestore(app);

  // 1. Fungsi Cari Username
  async function cariTeman(usernameTarget) {
    const q = query(collection(db, "users"), where("username", "==", usernameTarget));
    const querySnapshot = await getDocs(q);

    if (querySnapshot.empty) {
      alert("Username tidak ditemukan!");
      return null;
    }

    querySnapshot.forEach((doc) => {
      const targetUid = doc.id;
      const data = doc.data();
      alert("Pemain ditemukan: " + data.username);
      
      // Contoh langsung mengikuti setelah berhasil dicari (ganti 'UID_KAMU_DISINI' dengan UID Anda)
      ikutiTeman("UID_KAMU_DISINI", targetUid);
    });
  }

  // 2. Fungsi Ikuti Teman
  async function ikutiTeman(myUid, targetUid) {
    try {
      await setDoc(doc(db, "users", myUid, "following", targetUid), {
        followedAt: new Date()
      });
      alert("Berhasil mengikuti pemain!");
    } catch (error) {
      console.error("Gagal mengikuti:", error);
    }
  }

  // Daftarkan ke window agar bisa dipanggil dari tombol HTML biasa
  window.cariTeman = cariTeman;
  window.ikutiTeman = ikutiTeman;
</script>

